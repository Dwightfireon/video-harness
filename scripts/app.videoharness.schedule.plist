<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>app.videoharness.schedule</string>

  <!-- 每 30 分钟检查一次队列。真正的派发频率由 schedule.json 的
       dailyLimit 与 running 租期控制，这里只是"多久看一次"。 -->
  <key>StartInterval</key>
  <integer>1800</integer>

  <key>ProgramArguments</key>
  <array>
    <string>__NODE_BIN__</string>
    <string>__ROOT__/scripts/schedule-daemon.mjs</string>
    <string>--once</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__ROOT__</string>

  <key>StandardOutPath</key>
  <string>__ROOT__/diagnostics/schedule-daemon.log</string>
  <key>StandardErrorPath</key>
  <string>__ROOT__/diagnostics/schedule-daemon.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__NODE_DIR__:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>__HOME__</string>
  </dict>

  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
